{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/packages/rx-nested-bean",
    "target": "es2015",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "lib": ["es2018", "dom", "ESNext"],
    "typeRoots": ["../../node_modules/@types", "./node_modules/@types", "../../apps/web/node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "rxjs": ["../../apps/web/node_modules/rxjs"],
      "rxjs/*": ["../../apps/web/node_modules/rxjs/*"],
      "react": ["../../apps/web/node_modules/react"],
      "react/*": ["../../apps/web/node_modules/react/*"]
    }
  },
  "angularCompilerOptions": {
    "enableIvy": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "tmp"]
}
