# Global AI provider configuration
# Supported providers: openai, dashscope, openrouter, deepseek, kimi, glm
VITE_AI_PROVIDER=openai

# Default OpenAI-compatible endpoint credentials (used unless overridden per provider)
VITE_AI_API_KEY=sk-your-openai-key

# Dashscope (Alibaba Cloud Qwen) credentials
VITE_AI_DASHSCOPE_API_KEY=sk-your-dashscope-key

# OpenRouter credentials
VITE_OPENROUTER_API_KEY=sk-your-openrouter-key

# Deepseek credentials
VITE_DEEPSEEK_API_KEY=sk-your-deepseek-key

# Kimi (Moonshot) credentials
VITE_KIMI_API_KEY=sk-your-kimi-key

# GLM (Zhipu) credentials
VITE_GLM_API_KEY=sk-your-glm-key

# ============================================
# GitHub OAuth Configuration
# ============================================
# GitHub OAuth Client ID (required)
VITE_GITHUB_CLIENT_ID=Ov23li7gtCm6evUeqZ4d

# GitHub OAuth Redirect URI (required)
VITE_GITHUB_REDIRECT_URI=https://gitary.app/?platform=github

# GitHub OAuth Client Secret (required)
VITE_GITHUB_CLIENT_SECRET=your-client-secret-here

# ============================================
# Gitee OAuth Configuration
# ============================================
# Gitee OAuth Client ID (required)
VITE_GITEE_CLIENT_ID=your-gitee-client-id

# Gitee OAuth Redirect URI (optional, auto-generated if not set)
VITE_GITEE_REDIRECT_URI=http://localhost:5173/?platform=gitee

# Gitee OAuth Client Secret (required)
VITE_GITEE_CLIENT_SECRET=your-gitee-client-secret

# ============================================
# GitCode OAuth Configuration
# ============================================
# GitCode OAuth Client ID (required)
VITE_GITCODE_CLIENT_ID=your-gitcode-client-id

# GitCode OAuth Redirect URI (optional, auto-generated if not set)
VITE_GITCODE_REDIRECT_URI=http://localhost:5173/?platform=gitcode

# GitCode OAuth Client Secret (required)
VITE_GITCODE_CLIENT_SECRET=your-gitcode-client-secret