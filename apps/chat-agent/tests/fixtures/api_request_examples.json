  "schema": {
    "description": "RunAgentRequest - 运行 Agent 的请求格式",
    "required_fields": [
      "app_name",
      "user_id",
      "session_id",
      "new_message"
    ],
    "fields": {
      "app_name": {
        "type": "string",
        "required": true,
        "description": "Agent 应用名称，例如: image_2_scripts",
        "example": "image_2_scripts"
      },
      "user_id": {
        "type": "string",
        "required": true,
        "description": "用户 ID，用于标识不同用户",
        "example": "test_user_001"
      },
      "session_id": {
        "type": "string",
        "required": true,
        "description": "会话 ID，从创建会话端点获取，用于保持对话上下文",
        "example": "eced6b7f-f338-4500-8ad7-44f4e9dd3d00"
      },
      "new_message": {
        "type": "object",
        "required": true,
        "description": "新消息内容",
        "properties": {
          "role": {
            "type": "string",
            "required": true,
            "description": "消息角色",
            "enum": ["user", "assistant"],
            "example": "user"
          },
          "parts": {
            "type": "array",
            "required": true,
            "description": "消息部分数组",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "required": true,
                  "description": "文本内容或图片 URL（HTTP/HTTPS）",
                  "example": "hello"
                }
              }
            }
          }
        }
      }
    }
  },
